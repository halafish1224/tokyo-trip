                 { id: "d9", date: "12/22 (一)", title: "湘南海岸一日遊", dayMonth: "12/22",
                    events: [
                        { time: "14:00", loc: "鎌倉大佛", addr: "神奈川縣鎌倉市長谷3-11-2", map: "鎌倉大仏殿高徳院", illustration: "🙏", desc: "【背景】日本國寶露天大佛。" }
                    ]
                },
                 { id: "d14", date: "12/27 (六)", title: "返程日", dayMonth: "12/27",
                    events: [
                        { time: "15:35", loc: "航班 JX803 啟程", addr: "成田T2", map: "成田国際空港 第二ターミナル", illustration: "🛫", desc: "【背景】預計 18:45 抵達桃園機場。" }
                    ]
                }
            ]
        }
    ];
    
    // (為了讓範例完整，我補齊了必要的資料變數，實際使用時請替換回您完整的 itineraryData)
    const fullItineraryDataForDemo = itineraryData;


    function getParsedDate(dayMonth) {
        const parts = dayMonth.split('/');
        const month = parseInt(parts[0]) - 1; 
        const day = parseInt(parts[1]);
        const date = new Date(NOW.getFullYear(), month, day);
        return date;
    }


    // 渲染日曆導覽列 (維持邏輯，樣式已在 CSS 更改)
    function renderDateNavBar() {
        const navBar = document.getElementById('date-nav-bar');
        navBar.innerHTML = '';
        const allDates = [];

        fullItineraryDataForDemo.forEach(chapter => {
            chapter.dates.forEach(day => {
                allDates.push(day);
            });
        });

        allDates.forEach(day => {
            const dateObj = getParsedDate(day.dayMonth);
            const isToday = day.dayMonth === TODAY_MONTH_DAY;
            const item = document.createElement('div');
            item.className = `date-nav-item ${isToday ? 'current-day' : ''}`;
            item.innerText = day.dayMonth;
            
            item.onclick = () => {
                const targetElement = document.getElementById(`day-title-${day.id}`);
                if (targetElement) {
                    const offset = header.offsetHeight + navBar.offsetHeight + 20;
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = targetElement.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
                document.querySelectorAll('.date-nav-item').forEach(el => el.classList.remove('highlight'));
                if (!isToday) item.classList.add('highlight');
            };
            navBar.appendChild(item);
        });
        
        const currentDayElement = navBar.querySelector('.current-day');
        if (currentDayElement) {
            currentDayElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
    }


    function renderItinerary() {
        const container = document.getElementById('itinerary-content');
        let html = '';
        const header = document.querySelector('header');
        const navBar = document.querySelector('.date-nav-bar');

        fullItineraryDataForDemo.forEach(chapterItem => {
            // 修改章節標題的 Icon
            html += `<h3 class="chapter-title">🗻 ${chapterItem.chapter}</h3>`;
            
            chapterItem.dates.forEach(day => {
                const dateObj = getParsedDate(day.dayMonth);
                // 這裡為了演示，先註解掉過期判斷，讓所有卡片都清楚顯示水墨效果
                // const isPast = dateObj.setHours(0,0,0,0) < NOW.setHours(0,0,0,0); 
                const isPast = false; 
                const dayClass = isPast ? 'is-past' : ''; 

                let eventsHtml = '';

                day.events.forEach(evt => {
                    let fareInfo = evt.fare ? `<div class="card-fare" style="background:rgba(148, 60, 52, 0.1); border: 1px dashed var(--sumi-red-seal); padding: 8px; border-radius: 4px; font-size:0.9rem; margin-top:12px; color:var(--sumi-red-seal); font-weight:700;">💵 車資/路線： ${evt.fare}</div>` : '';
                    let descMatch = evt.desc.match(/【背景】(.*)/);
                    let backgroundInfo = descMatch ? descMatch[1] : ''; 
                    let desc = evt.desc.replace(/【背景】.*$/, ''); 

                    const mapUrl = getGoogleMapsUrl(evt.map || evt.loc);
                    const weatherUrl = getGoogleWeatherUrl(evt.loc);

                    // --- 新增：處理插圖顯示 ---
                    // 如果 illustration 是圖片連結 (檢查是否包含 http 或 data:image)
                    let illustrationHtml = '';
                    if (evt.illustration) {
                        if (evt.illustration.includes('http') || evt.illustration.includes('data:image')) {
                             illustrationHtml = `<div class="illustration-placeholder" style="background-image: url('${evt.illustration}'); background-size: cover; background-position: center; border:none;"></div>`;
                        } else {
                            // 否則當作 Emoji 顯示在 placeholder 中
                             illustrationHtml = `<div class="illustration-placeholder">${evt.illustration}</div>`;
                        }
                    }
                    // ---------------------------

                    eventsHtml += `
                        <div class="info-card ${chapterItem.accentClass}">
                            ${illustrationHtml} <span class="card-time">${evt.time}</span>
                            <div class="card-title" style="font-size:1.3rem; font-weight:800; margin-bottom:8px; font-family:'Shippori Mincho';">${evt.loc}</div>
                            <div class="card-meta-addr" style="color:${chapterItem.accentClass === 'project1' ? 'var(--sumi-ink-med)' : 'var(--sumi-red-seal)'}; font-size:0.95rem; font-weight:700;"><span style="filter:contrast(0.5)">📍</span> 地址/地標： ${evt.addr}</div>
                            <div class="card-desc" style="font-size:1rem; margin-top:12px; font-family:'Noto Serif TC';">${desc}</div>
                            ${fareInfo}
                            <div class="card-meta" style="color:var(--text-sub); font-size:0.9rem; margin-top:12px; border-top:1px solid var(--sumi-ink-light); padding-top:8px;"><span style="filter:contrast(0.5)">💡</span> 背景： ${backgroundInfo}</div>
                            <div class="btn-group">
                                <a href="${mapUrl}" target="_blank" class="action-btn btn-map">
                                    🗺️ Google導航
                                </a>
                                <a href="${weatherUrl}" target="_blank" class="action-btn btn-weather">
                                    ☁️ Google天氣
                                </a>
                            </div>
                        </div>
                    `;
                });

                // 修改日期標題的樣式，增加水墨線條
                html += `
                    <div class="date-section ${dayClass}" id="day-title-${day.id}" style="scroll-margin-top: 160px;">
                        <h4 style="color:var(--sumi-ink-dark); font-size:1.3rem; margin: 35px 0 20px; padding-left:15px; border-left: 6px solid ${chapterItem.accentClass === 'project1' ? 'var(--sumi-ink-med)' : 'var(--sumi-red-seal)'}; display: flex; align-items: center;">
                            <span style="font-size:1.5rem; margin-right:8px; filter: contrast(0.8);">📅</span> ${day.date} <br><span style="font-size:1.1rem; margin-left:10px; color:var(--text-sub);">${day.title}</span>
                        </h4>
                        ${eventsHtml}
                    </div>
                `;
            });
        });

        container.innerHTML = html;
        renderDateNavBar(); 
    }
    renderItinerary();

    // === Tab 切換邏輯 (維持不變) ===
    function switchTab(tabId, navEl) {
        document.querySelectorAll('.section').forEach(el => el.classList.remove('active'));
        document.getElementById('tab-' + tabId).classList.add('active');
        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
        navEl.classList.add('active');
        window.scrollTo(0,0);
    }

    // === 記帳與翻譯功能 (維持不變，樣式已透過 CSS 水墨化) ===
    let expenses = JSON.parse(localStorage.getItem('tokyo_expenses_sumi')) || [];
    const exchangeRate = 0.22; 

    function renderExpenses() {
        const list = document.getElementById('expense-list');
        const totalEl = document.getElementById('total-twd');
        list.innerHTML = '';
        let total = 0;
        expenses.forEach((item, idx) => {
            const twd = Math.round(item.jpy * exchangeRate);
            total += twd;
            list.innerHTML += `
                <li class="expense-item" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0;">
                    <div>
                        <div style="font-weight:800; font-size:1.1rem; color:var(--sumi-ink-dark); font-family:'Shippori Mincho';">${item.name || '一般消費'}</div>
                        <div style="color:var(--text-sub); font-size:0.95rem; font-family:'Noto Serif TC';">¥${item.jpy.toLocaleString()} <span style="color:var(--sumi-red-seal)">(約 NT$${twd.toLocaleString()})</span></div>
                    </div>
                    <button style="color:var(--sumi-red-seal); background:none; border:2px solid var(--sumi-red-seal); border-radius:50%; width:30px; height:30px; line-height:26px; text-align:center; padding:0; font-weight:bold;" onclick="removeExpense(${idx})">✕</button>
                </li>`;
        });
        totalEl.innerText = `NT$ ${total.toLocaleString()}`;
        localStorage.setItem('tokyo_expenses_sumi', JSON.stringify(expenses));
    }
    function addItem() {
        const jpyInput = document.getElementById('amount-jpy');
        const nameInput = document.getElementById('item-name');
        const jpy = parseInt(jpyInput.value);
        if (!jpy || jpy <= 0) { alert('請輸入有效的日幣金額'); return; }
        expenses.push({ jpy: jpy, name: nameInput.value });
        renderExpenses();
        jpyInput.value = ''; nameInput.value = '';
    }
    function removeExpense(idx) {
        expenses.splice(idx, 1);
        renderExpenses();
    }
    function clearList() {
        if(confirm('確定要清除所有記帳紀錄嗎？ (此操作無法復原)')) {
            expenses = [];
            renderExpenses();
        }
    }
    renderExpenses();

    function redirectToGoogleTranslate() {
        const text = document.getElementById('custom-translate-text').value;
        if (text) {
             const url = `https://translate.google.com/?sl=zh-TW&tl=ja&text=${encodeURIComponent(text)}&op=translate`;
             window.open(url, '_blank');
        } else {
            alert('請先輸入要翻譯的中文內容');
        }
    }
</script>
