<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>東京 2025 | 水墨行旅紀行</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700&family=Shippori+Mincho:wght@500;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            /* === 水墨畫配色 (Sumi-e Palette) === */
            --sumi-ink-dark: #2b2b2b;    /* 濃墨：主標題、深色背景 */
            --sumi-ink-med: #4a5a6a;     /* 淡墨(藍灰)：次要文字、邊框 */
            --sumi-ink-light: #8c9ea3;   /* 極淡墨：裝飾線條 */
            
            --sumi-red-seal: #943c34;    /* 硃砂紅 (印章色)：強調、按鈕 */
            --sumi-red-light: #bd6b64;   /* 淺硃砂 */
            
            --paper-bg-main: #f4f1e8;    /* 宣紙底色 (米黃) */
            --paper-bg-card: #fafaf5;    /* 卡片底色 (較亮) */
            
            --text-main: #2b2b2b;        /* 深墨字 */
            --text-sub: #666666;         /* 灰墨字 */
            
            /* 模擬宣紙紋理的噪點圖案 (Base64) */
            --paper-texture-url: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.08'/%3E%3C/svg%3E");

            /* Project 顏色區分 (轉換為水墨色調) */
            --proj1-accent: #4a5a6a; /* 墨藍 */
            --proj2-accent: #943c34; /* 硃砂紅 */
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            /* 將字體改為更有襯線感的 Noto Serif TC 和 Shippori Mincho */
            font-family: 'Shippori Mincho', 'Noto Serif TC', serif;
            background-color: var(--paper-bg-main);
            /* 疊加宣紙紋理 */
            background-image: var(--paper-texture-url);
            color: var(--text-main);
            margin: 0;
            padding-bottom: 90px;
            line-height: 1.7;
        }

        /* --- Header 水墨風格 --- */
        header {
            /* 捨棄漸層，改用深墨色塊搭配紋理 */
            background-color: var(--sumi-ink-dark);
            background-image: var(--paper-texture-url);
            color: var(--paper-bg-main);
            padding: 30px 20px 20px;
            text-align: center;
            /* 底部改為硃砂紅的粗邊框，模擬印泥 */
            border-bottom: 8px solid var(--sumi-red-seal);
            position: sticky;
            top: 0;
            z-index: 100;
            /* 柔和的墨暈陰影 */
            box-shadow: 0 4px 20px rgba(43, 43, 43, 0.3);
        }

        h1 {
            margin: 0;
            font-family: 'Shippori Mincho', serif;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 5px;
            /* 文字加上淡淡的墨暈光澤 */
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .date-badge {
            display: inline-block;
            background: rgba(244, 241, 232, 0.15); /* 半透明宣紙色 */
            padding: 6px 18px;
            /* 稍微不規則的圓角，模擬手繪 */
            border-radius: 20px 5px 20px 5px;
            font-size: 1rem;
            margin-top: 12px;
            color: #ddd;
            border: 2px solid rgba(244, 241, 232, 0.3);
            font-family: 'Noto Serif TC', serif;
        }

        /* --- 頂部日期導覽列 --- */
        .date-nav-bar {
            position: sticky;
            top: 108px; /* Header 高度調整 */
            background: var(--paper-bg-main);
            background-image: var(--paper-texture-url);
            overflow-x: scroll;
            white-space: nowrap;
            padding: 12px 5px;
            border-bottom: 3px solid var(--sumi-ink-light);
            z-index: 90;
            -webkit-overflow-scrolling: touch;
             /* 隱藏滾動條但保持功能 */
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;  /* IE 10+ */
        }
        .date-nav-bar::-webkit-scrollbar { display: none; /* Chrome/Safari/Webkit */ }


        .date-nav-item {
            display: inline-block;
            padding: 8px 14px;
            margin: 0 4px;
            /* 手繪感的圓角 */
            border-radius: 12px 4px;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-sub);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            font-family: 'Shippori Mincho', serif;
        }

        .date-nav-item.highlight {
            /* 選中時，模擬硃砂墨跡 */
            background-color: var(--sumi-red-seal);
            color: var(--paper-bg-main);
            border-color: var(--sumi-red-seal);
             /* 增加一點墨水暈染的陰影 */
            box-shadow: 2px 2px 5px rgba(148, 60, 52, 0.3);
            transform: rotate(-1deg); /* 輕微旋轉增加手繪感 */
        }

        .date-nav-item.current-day {
            /* 今日標示：深墨外框 */
            background-color: transparent;
            color: var(--sumi-ink-dark);
            border: 2px solid var(--sumi-ink-dark);
            font-weight: 900;
        }
        
        /* --- Container --- */
        .container {
            padding: 25px 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        /* --- 行程卡片 (Info Card) --- */
        .chapter-title {
            text-align: center; margin: 40px 0 25px; font-size: 1.6rem; color: var(--sumi-ink-dark);
            /* 底部改為墨水筆觸風格 */
            border-bottom: 3px solid var(--sumi-ink-med);
            display: inline-block; /* 改為 inline-block 讓線條跟著文字長度 */
            padding-bottom: 10px;
            font-weight: 800;
            font-family: 'Shippori Mincho', serif;
            position: relative;
            left: 50%;
            transform: translateX(-50%);
        }

        /* 日期標題样式調整 */
        .date-section h4 {
             font-family: 'Shippori Mincho', serif;
             font-weight: 800;
             letter-spacing: 1px;
        }


        .info-card {
            background: var(--paper-bg-card);
            /* 疊加紋理 */
            background-image: var(--paper-texture-url);
            /* 不規則圓角 */
            border-radius: 8px 2px 8px 2px;
            padding: 25px;
            margin-bottom: 25px;
            /* 邊框改為深墨色，稍微粗一點 */
            border: 2px solid var(--sumi-ink-light);
            /* 柔和的墨暈陰影 */
            box-shadow: 3px 3px 10px rgba(43, 43, 43, 0.08);
            position: relative;
            transition: filter 0.5s;
        }

        /* New: Project 顏色條 (模擬墨條) */
        .info-card.project1 { border-left: 8px solid var(--proj1-accent); }
        .info-card.project2 { border-left: 8px solid var(--proj2-accent); }

        /* New: 低彩度顯示已過日期 (水墨淡出效果) */
        .date-section.is-past .info-card {
            filter: grayscale(100%) opacity(0.6);
            border-color: #ccc;
            box-shadow: none;
        }
        .date-section.is-past h4 {
             color: var(--text-sub) !important;
             border-left-color: var(--text-sub) !important;
        }


        .card-time {
            display: inline-block;
            /* 深墨底 */
            background: var(--sumi-ink-dark); 
            color: var(--paper-bg-main); 
            padding: 4px 12px;
            /* 不規則圓角 */
            border-radius: 10px 2px; 
            font-size: 0.95rem; font-weight: 700; margin-bottom: 12px;
            font-family: 'Noto Serif TC', serif;
        }

        /* 新增：模擬插圖的容器 */
        .illustration-placeholder {
            width: 100%;
            height: 120px;
            background-color: rgba(0,0,0,0.03);
            border: 2px dashed var(--sumi-ink-light);
            border-radius: 8px;
            margin-bottom: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 3rem;
            color: var(--sumi-ink-light);
            font-family: 'Shippori Mincho', serif;
            /* 這裡未來可以用 <img> 標籤替換，放入真正的水墨插圖 */
        }
        
        /* --- Buttons --- */
        .btn-group { display: flex; gap: 15px; margin-top: 20px; }
        .action-btn {
            flex: 1; text-align: center; padding: 12px 0; 
            /* 模擬印章風格 */
            border-radius: 4px;
            text-decoration: none; font-weight: 800; font-size: 1rem;
            transition: all 0.2s; display: flex; align-items: center; 
            justify-content: center; gap: 8px;
            font-family: 'Shippori Mincho', serif;
            border: 2px solid;
        }
        .btn-map { 
            /* 硃砂紅印章 */
            background: var(--sumi-red-seal); 
            color: var(--paper-bg-main);
            border-color: var(--sumi-red-seal);
            box-shadow: 2px 2px 0 var(--sumi-ink-dark); 
        }
        .btn-weather { 
            /* 墨色印章 */
            background: var(--sumi-ink-dark); 
            color: var(--paper-bg-main);
            border-color: var(--sumi-ink-dark);
            box-shadow: 2px 2px 0 var(--sumi-ink-med); 
        }
        .action-btn:active {
            transform: translate(2px, 2px);
            box-shadow: none;
        }


        /* 大按鈕通用 */
        .btn-large {
            width: 100%; padding: 15px; 
            background: var(--sumi-red-seal); color: var(--paper-bg-main);
            border: 2px solid var(--sumi-red-seal); border-radius: 4px; 
            font-size: 1.2rem; font-weight: 800;
            box-shadow: 3px 3px 0 var(--sumi-ink-dark); margin-top: 15px;
            font-family: 'Shippori Mincho', serif;
        }
        .btn-large:active { transform: translate(3px, 3px); box-shadow: none; }
        
        /* 記帳頁面樣式 (水墨化) */
        .total-display {
            background: var(--sumi-ink-dark);
            background-image: var(--paper-texture-url);
            color: var(--paper-bg-main); padding: 25px; 
            border-radius: 8px 2px; margin-bottom: 25px;
            text-align: center;
            border-bottom: 5px solid var(--sumi-red-seal);
        }
        .total-label { font-size: 1.1rem; opacity: 0.9; font-family: 'Noto Serif TC', serif; }
        .total-amount { font-size: 2.8rem; font-weight: 900; font-family: 'Shippori Mincho', serif; }
        
        input[type="number"], input[type="text"] {
            width: 100%; padding: 14px; font-size: 1.1rem; 
            background: var(--paper-bg-card);
            border: 2px solid var(--sumi-ink-light); border-radius: 4px;
            font-family: 'Noto Serif TC', serif;
        }
        input:focus { outline: none; border-color: var(--sumi-ink-med); }

        .expense-item { border-bottom: 2px dashed var(--sumi-ink-light); }
        
        /* 翻譯頁面樣式 (水墨化) */
        .trans-card {
            background: var(--paper-bg-card); padding: 20px; 
            border-radius: 8px 2px; 
            border: 2px solid var(--sumi-ink-light);
            box-shadow: 3px 3px 8px rgba(43, 43, 43, 0.05);
        }
        .trans-jp { font-family: 'Shippori Mincho', serif; font-size: 1.4rem; font-weight: 800; color: var(--sumi-red-seal); margin: 8px 0; }
        
        /* 底部導航 (水墨化) */
        .nav-bar {
            position: fixed; bottom: 0; left: 0; width: 100%; 
            background: var(--paper-bg-main);
            background-image: var(--paper-texture-url);
            display: flex; justify-content: space-around; padding: 12px 0;
            border-top: 3px solid var(--sumi-ink-med); z-index: 100;
        }
        .nav-item {
            text-align: center; font-size: 0.9rem; color: var(--text-sub); cursor: pointer; flex: 1;
            transition: color 0.3s;
            font-family: 'Noto Serif TC', serif;
            font-weight: 700;
        }
        .nav-item.active { color: var(--sumi-red-seal); font-weight: 900; }
        .nav-icon { font-size: 1.6rem; display: block; margin-bottom: 4px; filter: contrast(0.8); }

        .section { display: none; }
        .section.active { display: block; }
    </style>
</head>
<body>

<header>
    <h1>東京冬日紀行</h1>
    <div class="date-badge" id="current-date">LOADING...</div>
</header>

<div class="container">

    <div id="tab-trip" class="section active">
        <h2 class="section-title" style="text-align:center; font-family:'Shippori Mincho'; font-weight:800;">⛰️ 行程總覽與導航</h2>
        
        <div class="date-nav-bar" id="date-nav-bar">
        </div>

        <div id="itinerary-content">
        </div>
    </div>

    <div id="tab-calc" class="section">
        <h2 class="section-title" style="text-align:center; font-family:'Shippori Mincho'; font-weight:800;">💴 旅費記帳與換算</h2>
        <div class="total-display">
            <div class="total-label">總消費預估 (TWD)</div>
            <div class="total-amount" id="total-twd">NT$ 0</div>
        </div>

        <div class="input-group">
            <label>日幣金額 (JPY)</label>
            <input type="number" id="amount-jpy" placeholder="¥ 0" inputmode="numeric">
        </div>
        <div class="input-group">
            <label>商品名稱 (選填)</label>
            <input type="text" id="item-name" placeholder="請輸入消費項目">
        </div>
        <button class="btn-large" onclick="addItem()">＋ 加入清單</button>

        <h3 style="margin-top:40px; color:var(--text-main); font-size:1.2rem; border-bottom: 2px solid var(--sumi-ink-light); padding-bottom: 10px; font-family:'Shippori Mincho';">消費明細</h3>
        <ul class="expense-list" id="expense-list"></ul>
        <button style="width:100%; padding:12px; background:var(--paper-bg-card); border:2px solid var(--sumi-ink-light); color:var(--text-sub); border-radius:4px; margin-top:25px; font-weight:bold;" onclick="clearList()">🗑️ 清除所有紀錄</button>
    </div>

    <div id="tab-trans" class="section">
        <h2 class="section-title" style="text-align:center; font-family:'Shippori Mincho'; font-weight:800;">🗣️ 溝通翻譯機</h2>
        <div class="input-group">
            <label>即時翻譯 (輸入中文)</label>
            <input type="text" id="custom-translate-text" placeholder="輸入中文，將導向 Google 翻譯...">
            <button class="btn-large" style="background:var(--sumi-ink-dark); border-color:var(--sumi-ink-dark); box-shadow: 3px 3px 0 var(--sumi-ink-med);" onclick="redirectToGoogleTranslate()">
                Google 翻譯 (中翻日) ➔
            </button>
        </div>

        <h3 style="margin-top:40px; color:var(--text-main); font-size:1.2rem; border-bottom: 2px solid var(--sumi-ink-light); padding-bottom: 10px; font-family:'Shippori Mincho';">常用語指差卡</h3>
        <div class="trans-grid">
            <div class="trans-card">
                <div>請問這個多少錢？</div>
                <div class="trans-jp">これはいくらですか？</div>
                <div class="trans-sub">Kore wa ikura desu ka?</div>
            </div>
            <div class="trans-card">
                <div>可以免稅嗎？</div>
                <div class="trans-jp">免税はできますか？</div>
                <div class="trans-sub">Menzei wa dekimasu ka?</div>
            </div>
            <div class="trans-card">
                <div>我要這個。</div>
                <div class="trans-jp">これをください。</div>
                <div class="trans-sub">Kore o kudasai.</div>
            </div>
            <div class="trans-card">
                <div>可以刷卡嗎？</div>
                <div class="trans-jp">カードは使えますか？</div>
                <div class="trans-sub">Ka-do wa tsukaemasu ka?</div>
            </div>
        </div>
    </div>

</div>

<nav class="nav-bar">
    <div class="nav-item active" onclick="switchTab('trip', this)">
        <span class="nav-icon">🏮</span>行程導航
    </div>
    <div class="nav-item" onclick="switchTab('calc', this)">
        <span class="nav-icon">💰</span>記帳本
    </div>
    <div class="nav-item" onclick="switchTab('trans', this)">
        <span class="nav-icon">🗣️</span>翻譯機
    </div>
</nav>

